# Visual Studio 2015 user specific files
.vs/
.idea/
.codebuddy/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
!Source/ThirdParty/**/*.dll
!Plugins/**/ThirdParty/**/*.dll
!Source/ThirdParty/**/*.dylib
!Plugins/**/ThirdParty/**/*.dylib

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib
!Source/ThirdParty/**/*.lib
!Plugins/**/ThirdParty/**/*.lib

# Executables
*.exe
*.out
*.app
*.ipa
!Plugins/UIPacker/Content/TexturePacker/bin/*.exe
!Plugins/UIPacker/Content/TexturePacker/bin/*.dll

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Local/User specific configuration (do not commit)
Config/Local*.ini
Config/User*.ini
ue-mcp.local.yml

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

